# Path to the OAuth client secrets JSON downloaded from Google Cloud Console
# (APIs & Services -> Credentials -> OAuth 2.0 Client ID -> Desktop app)
GOOGLE_CLIENT_SECRETS_FILE=./client_secret.json

# Where oauth_setup.py will save/read the long-lived refresh token
GOOGLE_TOKEN_FILE=./token.json

# Simple API key for Places API (competitor ratings only — no OAuth needed)
# Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> API key
GOOGLE_PLACES_API_KEY=your_places_api_key_here

# GNews API key (news/press ingestion — fetch_news_articles.py). Free-tier
# self-serve signup at https://gnews.io, no approval wait. See
# docs/decisions/news-press-ingestion-path.md for why GNews.
GNEWS_API_KEY=your_gnews_api_key_here

# Phase 2 foundations (backend/app/) — where the mentions/reviews/articles
# and ingestion-run-ledger tables live. See docs/decisions/persistence-choice.md.
# This default matches `docker compose up -d` in this folder (docker-compose.yml).
DATABASE_URL=postgresql+psycopg://remedy_pulse:remedy_pulse_dev@localhost:5434/remedy_pulse

# Reddit "script" app credentials (4.3 — fetch_reddit_mentions.py). Register
# a self-serve script app at https://www.reddit.com/prefs/apps (no approval
# wait — distinct from the elevated commercial Data Access tier described in
# docs/Remedy Pulse_Reddit Data Access_Use Case.pdf, which is a separate,
# still-pending approval). The script then authenticates as this account.
REDDIT_CLIENT_ID=your_reddit_script_app_client_id
REDDIT_CLIENT_SECRET=your_reddit_script_app_client_secret
REDDIT_USERNAME=your_reddit_account_username
REDDIT_PASSWORD=your_reddit_account_password

# Meta Graph API (4.4 — fetch_meta_mentions.py). Requires the Instagram/
# Facebook account connected as a Business asset, and Meta App Review for
# each capability (see the checklist's HEADS-UP: Instagram comments,
# Instagram mentions, and Facebook comments are three separate permission
# scopes with three separate review outcomes — not yet approved as of this
# writing; each capability is independently "not_configured" until its env
# vars below are set, so partial approval doesn't block what IS approved).
META_ACCESS_TOKEN=your_meta_graph_api_access_token
META_IG_BUSINESS_ACCOUNT_ID=your_instagram_business_account_id
META_PAGE_ID=your_facebook_page_id
# META_API_VERSION=v19.0   # optional, defaults to v19.0 if unset

# Auth primitives (5.5 — app/auth.py), used by the Phase 7 API layer
# (app/api/) to sign session tokens. Falls back to a random per-process
# key if unset — fine for a one-off script, NOT fine for the API server:
# every issued token becomes invalid the moment the process restarts. Set
# this explicitly before running `uvicorn app.api.main:app` for anything
# beyond a quick local check.
SESSION_SECRET_KEY=generate_a_long_random_string_for_this

# Anthropic API key (Phase 6 — app/classification.py's sentiment/alert
# classifier, app/topic_tagging.py's topic tagging). Self-serve signup at
# https://console.anthropic.com, no approval wait. See
# docs/decisions/sentiment-classifier-choice.md for the model choice.
ANTHROPIC_API_KEY=your_anthropic_api_key_here

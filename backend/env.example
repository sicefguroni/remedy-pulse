# Path to the OAuth client secrets JSON downloaded from Google Cloud Console
# (APIs & Services -> Credentials -> OAuth 2.0 Client ID -> Desktop app)
GOOGLE_CLIENT_SECRETS_FILE=./client_secret.json

# Where oauth_setup.py will save/read the long-lived refresh token
GOOGLE_TOKEN_FILE=./token.json

# Simple API key for Places API (competitor ratings only — no OAuth needed)
# Cloud Console -> APIs & Services -> Credentials -> Create Credentials -> API key
GOOGLE_PLACES_API_KEY=your_places_api_key_here
